# EclipseSSH Spotless / ktlint config — used by both local `./gradlew spotlessApply`
# and the autofix.yml GitHub Action so the two never disagree.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
# Legacy code (maragung fork) routinely uses lines up to ~180 chars in
# terminal parser / SSH channel code where breaking them hurts readability.
# New code should stay under 140; the gate is not enforced via ktlint so
# existing files do not need a sweep to land.
max_line_length = 200

[*.{kt,kts}]
# ktlint_official ruleset. The disabled rules below are deliberate: the
# maragung-era code already shipped under these violations, and retroactive
# enforcement would churn 100+ files for no signal. New code is still held
# to the standard via the autofix.yml workflow, which runs spotlessApply on
# every PR and commits the formatting diff back.
#
# Disabled rules + the reason each was disabled:
#   no-wildcard-imports     — legacy imports use wildcards in places; a sweep
#                             is a separate focused PR, not a CI gate.
#   filename                — several legacy files (ForegroundTypePolicy.kt
#                             contains class ForegroundNeed; etc.) do not
#                             match their single class name.
#   max-line-length         — see the [*] block above; 200 not 140.
#   no-consecutive-comments — legacy code has KDoc-then-block-comment
#                             sequences that read fine; renaming them away
#                             is churn.
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_filename = disabled
ktlint_standard_no-consecutive-comments = disabled
ktlint_standard_max-line-length = disabled
ktlint_standard_function-naming = enabled

# JetBrains Mono ships in app/src/main/res/font; the editor default is set so
# contributors editing in Android Studio see the same metrics the renderer ships.
ij_java_class_count_to_use_import_on_demand = 999
ij_kotlin_name_count_to_use_import_on_demand = 999

[*.{yml,yaml}]
indent_size = 2
max_line_length = 200

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
